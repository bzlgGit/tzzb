<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Status bar area -->
    <TextView
        android:id="@+id/tvStatusTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="9:41"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivStatusIcons"
        android:layout_width="60dp"
        android:layout_height="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@id/tvStatusTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvStatusTime" />

    <!-- Top header bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatusTime">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="关注"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivChart"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:text="PK"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivChart"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPk"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tabs -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <TextView
            android:id="@+id/tvTabOptional"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="自选"
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tvTabHolding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabHolding"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="持仓"
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tvTabPortfolio"
            app:layout_constraintStart_toEndOf="@id/tvTabOptional"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabPortfolio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="组合"
            android:textColor="#E94B3C"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvTabMatch"
            app:layout_constraintStart_toEndOf="@id/tvTabHolding"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="比赛"
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tvTabBull"
            app:layout_constraintStart_toEndOf="@id/tvTabPortfolio"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabBull"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="牛人"
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTabMatch"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tabIndicator"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="2dp"
            android:background="#E94B3C"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tvTabPortfolio"
            app:layout_constraintStart_toStartOf="@id/tvTabPortfolio" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter chips -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabBar">

        <TextView
            android:id="@+id/tvChipAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FDE8E5"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="全部 54"
            android:textColor="#E94B3C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvChipMine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#F5F5F5"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="我创建的 28"
            android:textColor="#666666"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvChipOthers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#F5F5F5"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="他人的 8"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Table header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/listHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/filterBar">

        <TextView
            android:id="@+id/tvHeaderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="组合名称"
            android:textColor="#999999"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderReturn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:text="近1月 ↕"
            android:textColor="#999999"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFollow"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderFollow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关注人数 ↕"
            android:textColor="#999999"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Portfolio list rows -->
    <LinearLayout
        android:id="@+id/portfolioList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/listHeader">

        <!-- Row 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI算力核心仓"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow1Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FDE8E5"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="我的"
                android:textColor="#E94B3C"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow1Name" />

            <TextView
                android:id="@+id/tvRow1Type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="自创组合"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@id/tvRow1Tag"
                app:layout_constraintStart_toEndOf="@id/tvRow1Tag"
                app:layout_constraintTop_toTopOf="@id/tvRow1Tag" />

            <TextView
                android:id="@+id/tvRow1Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+25.45%"
                android:textColor="#E94B3C"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow1Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow1Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow1Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="245"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="长期定投组合持仓"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow2Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="沧海桑田"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow2Name" />

            <TextView
                android:id="@+id/tvRow2Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-10.79%"
                android:textColor="#3399FF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow2Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow2Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow2Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.99w"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow3Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="美股科技七雄"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow3Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="主理人"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow3Name" />

            <TextView
                android:id="@+id/tvRow3Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+25.45%"
                android:textColor="#E94B3C"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow3Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow3Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow3Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="254"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 4 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow4Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="创新药组合"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow4Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="小韭菜"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow4Name" />

            <TextView
                android:id="@+id/tvRow4Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-10.79%"
                android:textColor="#3399FF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow4Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow4Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow4Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="54"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 5 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow5Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="红利低播稳健"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow5Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="452214"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow5Name" />

            <TextView
                android:id="@+id/tvRow5Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-9.75%"
                android:textColor="#3399FF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow5Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow5Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow5Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="245"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 6 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvRow6Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="白酒消费"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow6Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="主理人"
                android:textColor="#999999"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRow6Name" />

            <TextView
                android:id="@+id/tvRow6Return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+25.45%"
                android:textColor="#E94B3C"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRow6Follow"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/tvRow6Name"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRow6Follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8511"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Promo card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/promoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="#F8F8F8"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/portfolioList">

        <ImageView
            android:id="@+id/ivPromoPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPromoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="发现更多优质组合"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnPromoGo"
            app:layout_constraintStart_toEndOf="@id/ivPromoPlus"
            app:layout_constraintTop_toTopOf="@id/ivPromoPlus" />

        <TextView
            android:id="@+id/tvPromoSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="或创建你自己的组合"
            android:textColor="#999999"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/tvPromoTitle"
            app:layout_constraintStart_toStartOf="@id/tvPromoTitle"
            app:layout_constraintTop_toBottomOf="@id/tvPromoTitle" />

        <TextView
            android:id="@+id/btnPromoGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E94B3C"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="去看看"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom navigation bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tabAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tabStock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="投资账本"
                android:textColor="#666666"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabStock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tabFund"
            app:layout_constraintStart_toEndOf="@id/tabAccount"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="股票"
                android:textColor="#666666"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabFund"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tabFollow"
            app:layout_constraintStart_toEndOf="@id/tabStock"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="基金"
                android:textColor="#666666"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabFollow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tabCommunity"
            app:layout_constraintStart_toEndOf="@id/tabFund"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="关注"
                android:textColor="#E94B3C"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCommunity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tabFollow"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="社区"
                android:textColor="#666666"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Index banner (sits above bottom nav) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/indexBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#FFF7F6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <TextView
            android:id="@+id/tvIndexName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上证指数"
            android:textColor="#333333"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIndexChangePct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1.25%"
            android:textColor="#E94B3C"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIndexChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="+15.57"
            android:textColor="#E94B3C"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvIndexChangePct"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIndexValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="4122.54"
            android:textColor="#E94B3C"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvIndexChange"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
