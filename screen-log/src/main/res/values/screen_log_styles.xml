<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ScreenLogTheme" parent="android:style/Theme.Material.Light.NoActionBar" />

    <style name="ScreenLogSettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/screen_log_page_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenLogSettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/screen_log_settings_card_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ScreenLogSettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:thumbTint">@color/screen_log_switch_thumb</item>
        <item name="android:trackTint">@color/screen_log_switch_track</item>
        <item name="android:textColor">@color/screen_log_page_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ScreenLogSettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/screen_log_page_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ScreenLogSettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/screen_log_page_divider</item>
    </style>
</resources>
