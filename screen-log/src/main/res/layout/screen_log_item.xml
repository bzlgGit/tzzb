<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/screenLogTime"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:textColor="@color/screen_log_text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenLogLevelText"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/screenLogTime"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenLogTagText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/screenLogLevelText"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenLogMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/screenLogTagText"
        app:layout_constraintTop_toBottomOf="@id/screenLogTagText" />

    <TextView
        android:id="@+id/screenLogExtras"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/screen_log_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/screenLogMessage"
        app:layout_constraintTop_toBottomOf="@id/screenLogMessage" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:background="@color/screen_log_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/screenLogMessage"
        app:layout_constraintTop_toBottomOf="@id/screenLogExtras" />
</androidx.constraintlayout.widget.ConstraintLayout>
