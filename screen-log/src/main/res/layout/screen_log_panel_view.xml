<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_log_panel_bg"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/screenLogNormalBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/screenLogTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/screen_log_panel_title"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screenLogCopyFiltered"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/screen_log_ic_copy"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_copy_action"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenLogClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/screen_log_ic_clear"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_clear_screen"
            android:textColor="@color/screen_log_brand"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenLogFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_fullscreen"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenLogSettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/screen_log_ic_settings"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_settings"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenLogSelectionBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/screenLogSelectionClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/screen_log_ic_close"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_cancel_selection"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenLogSelectionCount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screenLogSelectionAll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/screen_log_select_all"
            android:textColor="@color/screen_log_brand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/screenLogSelectionCopy"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/screen_log_ic_copy"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/screen_log_copy_action"
            android:textColor="@color/screen_log_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/screenLogSearch"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/screen_log_field_bg"
        android:drawableStart="@drawable/screen_log_ic_search"
        android:drawablePadding="8dp"
        android:hint="@string/screen_log_search_hint"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/screen_log_text_primary"
        android:textColorHint="@color/screen_log_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogNormalBar" />

    <Spinner
        android:id="@+id/screenLogLevel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/screen_log_field_bg"
        android:popupBackground="@color/screen_log_surface"
        app:layout_constraintEnd_toStartOf="@id/screenLogTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogSearch" />

    <Spinner
        android:id="@+id/screenLogTag"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/screen_log_field_bg"
        android:popupBackground="@color/screen_log_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/screenLogLevel"
        app:layout_constraintTop_toTopOf="@id/screenLogLevel" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/screenLogList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogLevel" />
</androidx.constraintlayout.widget.ConstraintLayout>
