<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_log_panel_bg"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/screenLogTitle"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:text="@string/screen_log_panel_title"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/screenLogCopyFiltered"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/screen_log_button_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/screen_log_copy_filtered"
        android:textAllCaps="false"
        android:textColor="@color/screen_log_accent"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/screenLogTitle"
        app:layout_constraintEnd_toStartOf="@id/screenLogClear"
        app:layout_constraintTop_toTopOf="@id/screenLogTitle" />

    <Button
        android:id="@+id/screenLogClear"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/screen_log_button_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/screen_log_clear"
        android:textAllCaps="false"
        android:textColor="@color/screen_log_accent"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/screenLogTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/screenLogTitle" />

    <EditText
        android:id="@+id/screenLogSearch"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/screen_log_field_bg"
        android:hint="@string/screen_log_search_hint"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/screen_log_text_primary"
        android:textColorHint="@color/screen_log_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogTitle" />

    <Spinner
        android:id="@+id/screenLogLevel"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/screen_log_field_bg"
        app:layout_constraintEnd_toStartOf="@id/screenLogTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogSearch" />

    <Spinner
        android:id="@+id/screenLogTag"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/screen_log_field_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/screenLogLevel"
        app:layout_constraintTop_toTopOf="@id/screenLogLevel" />

    <Switch
        android:id="@+id/screenLogRecording"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:gravity="center_vertical"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:switchMinWidth="40dp"
        android:switchPadding="8dp"
        android:text="@string/screen_log_recording"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/screenLogAutoScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogLevel" />

    <Switch
        android:id="@+id/screenLogAutoScroll"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:checked="true"
        android:gravity="center_vertical"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:switchMinWidth="40dp"
        android:switchPadding="8dp"
        android:text="@string/screen_log_auto_scroll"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/screenLogRecording"
        app:layout_constraintTop_toTopOf="@id/screenLogRecording" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/screenLogList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogRecording" />
</androidx.constraintlayout.widget.ConstraintLayout>
