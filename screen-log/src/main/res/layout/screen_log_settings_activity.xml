<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_log_bg"
    android:padding="18dp">

    <TextView
        android:id="@+id/screenLogSettingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/screen_log_settings"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenLogSettingsSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/screen_log_text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogSettingsTitle" />

    <TextView
        android:id="@+id/screenLogTouchTargetLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/screen_log_touch_target"
        android:textColor="@color/screen_log_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogSettingsSummary" />

    <Button
        android:id="@+id/screenLogTouchLogPanel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/screen_log_button_bg"
        android:text="@string/screen_log_touch_log_panel"
        android:textAllCaps="false"
        android:textColor="@color/screen_log_accent"
        app:layout_constraintEnd_toStartOf="@id/screenLogTouchUnderlyingPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogTouchTargetLabel" />

    <Button
        android:id="@+id/screenLogTouchUnderlyingPage"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/screen_log_button_bg"
        android:text="@string/screen_log_touch_underlying_page"
        android:textAllCaps="false"
        android:textColor="@color/screen_log_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/screenLogTouchLogPanel"
        app:layout_constraintTop_toTopOf="@id/screenLogTouchLogPanel" />

    <Button
        android:id="@+id/screenLogClearAll"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/screen_log_button_bg"
        android:text="@string/screen_log_clear"
        android:textAllCaps="false"
        android:textColor="@color/screen_log_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenLogTouchLogPanel" />
</androidx.constraintlayout.widget.ConstraintLayout>
